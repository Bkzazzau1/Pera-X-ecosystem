# Pera-X / PEX deployment environment example
# Copy this file to .env locally and fill in real values.
# Never commit .env, keypairs, private keys, or seed phrases.

# Solana cluster: localnet | devnet | mainnet-beta
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Local deployer keypair path only. Do not commit this file.
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# PEX token configuration
PEX_TOKEN_NAME=Pera-X
PEX_TOKEN_SYMBOL=PEX
PEX_TOKEN_DECIMALS=6
PEX_TOTAL_SUPPLY=1000000000
PEX_INITIAL_PRICE_USD=0.000012

# Pera-X core program
PERAX_CORE_PROGRAM_ID=REPLACE_AFTER_DEPLOYMENT

# Token mint and authority addresses
PEX_MINT_ADDRESS=REPLACE_AFTER_MINT_CREATION
PEX_MINT_AUTHORITY=REPLACE_WITH_MINT_AUTHORITY_PUBLIC_KEY
PEX_FREEZE_AUTHORITY=REPLACE_WITH_FREEZE_AUTHORITY_OR_NONE

# Trading company token account used by the Anchor program
TRADING_COMPANY_TOKEN_ACCOUNT=REPLACE_WITH_TRADING_COMPANY_TOKEN_ACCOUNT

# Optional safety controls
MAX_PAYMENT_AMOUNT=0
ENABLE_EMERGENCY_PAUSE=true

# Meteora / initial liquidity guidance
INITIAL_LIQUIDITY_DEX=Meteora
INITIAL_LIQUIDITY_PAIR=PEX/USDC
INITIAL_LIQUIDITY_PEX_AMOUNT=250000000
INITIAL_LIQUIDITY_QUOTE_USD=3000
