# Pera-X deployment environment example
# Copy this file to .env locally and fill in real values.
# Keep real local secret values outside Git.

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

PEX_TOKEN_NAME=Pera-X
PEX_TOKEN_SYMBOL=PEX
PEX_TOKEN_DECIMALS=6
PEX_TOTAL_SUPPLY=1000000000
PEX_INITIAL_PRICE_USD=0.000012
PEX_FIXED_SUPPLY=true

PERAX_CORE_PROGRAM_ID=REPLACE_AFTER_DEPLOYMENT

PEX_MINT_ADDRESS=REPLACE_AFTER_MINT_CREATION
PEX_MINT_AUTHORITY=REPLACE_WITH_MINT_AUTHORITY_PUBLIC_KEY
PEX_FREEZE_AUTHORITY=REPLACE_WITH_FREEZE_AUTHORITY_OR_NONE

# Trading Company token accounts
# Locked/strategic account is not used for daily PEX-for-Credits revenue.
TRADING_COMPANY_TOKEN_ACCOUNT=REPLACE_WITH_TRADING_COMPANY_LOCKED_TOKEN_ACCOUNT

# Revenue/second account receives PEX-for-Credits payments and is used for immediate burn source.
TRADING_COMPANY_REVENUE_TOKEN_ACCOUNT=REPLACE_WITH_TRADING_COMPANY_REVENUE_TOKEN_ACCOUNT

MAX_PAYMENT_AMOUNT=0
ENABLE_EMERGENCY_PAUSE=true

# Meteora DLMM / initial liquidity guidance
# Full 38% liquidity allocation at the approved initial price.
INITIAL_LIQUIDITY_DEX=Meteora DLMM
INITIAL_LIQUIDITY_PAIR=PEX/USDC
INITIAL_LIQUIDITY_PEX_AMOUNT=380000000
INITIAL_LIQUIDITY_QUOTE_USD=4560
